{
  "name": "slimr-serve",
  "version": "0.3.1",
  "description": "Header-only typed tool servers",
  "dependencies": [
    {
      "name": "slimr-bugsink",
      "version>=": "0.1.1"
    },
    {
      "name": "slimr-json",
      "version>=": "0.1.1"
    },
    {
      "name": "slimr-reflect",
      "version>=": "0.1.1"
    }
  ],
  "features": {
    "http": {
      "description": "Plain JSON HTTP and daemon server support via cpp-httplib",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "default-features": false,
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "yaml": {
      "description": "Opt-in YAML request/response body support via slimr-yaml",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "default-features": false,
          "features": [
            "openssl"
          ]
        },
        {
          "name": "slimr-yaml",
          "version>=": "0.1.1"
        }
      ]
    }
  }
}
